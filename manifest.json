{
  "name": "Inzu",
  "short_name": "Inzu",
  "description": "Manage rental properties with offline sync",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#A64456",
  "theme_color": "#A64456",
  "orientation": "portrait-primary",
  "share_target": [
    {
      "action": "/",
      "method": "GET",
      "params": {
        "text": "shared_text",
        "title": "shared_title"
      }
    },
    {
      "action": "/",
      "method": "GET", 
      "params": {
        "files": [
          {
            "name": "shared_image",
            "accept": ["image/*"]
          }
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}